# @stylescape packages live in GitHub Packages, not on npmjs.com. The
# registry is named here and a token deliberately is not: locally it comes
# from your own ~/.npmrc, in CI from the workflow's GITHUB_TOKEN. A token in
# a file inside the repository is one `git add -A` away from being published.
#
# stylescape core itself (the unscoped `stylescape`) comes from npmjs.com.
@stylescape:registry=https://npm.pkg.github.com
save-exact=false
package-lock=true
